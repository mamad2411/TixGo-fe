{
  "name": "tixgo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "api:gen": "openapi-typescript ../backend/api/openapi.yaml -o src/api/generated/schema.d.ts",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "api:lint": "redocly lint ../backend/api/openapi.yaml --config ../backend/redocly.yaml",
    "analyze": "ANALYZE=1 vite build",
    "perf:lighthouse": "pnpm dlx lighthouse http://localhost:4173 --only-categories=performance,accessibility,seo,best-practices --chrome-flags=\"--headless=new\" --output=json --output-path=./lighthouse-report.json --quiet",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@panzoom/panzoom": "^4.6.2",
    "@unhead/vue": "^3.4.3",
    "@vicons/tabler": "^0.13.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "gsap": "3.15.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lenis": "1.3.27",
    "marked": "12.0.2",
    "naive-ui": "^2.45.3",
    "papaparse": "^5.7.1",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "three": "0.170.0",
    "vue": "^3.5.45",
    "vue-advanced-cropper": "^2.8.9",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@redocly/cli": "^2.78.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.170.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
