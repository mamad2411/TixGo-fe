# Template nginx (envsubst: ${API_UPSTREAM}, ${DNS_RESOLVER}). Sajikan SPA + proxy API/WS ke backend.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Aset .gz/.br dibuat saat build (vite-plugin-compression2).
  gzip_static on;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  include /etc/nginx/snippets/security-headers.conf;

  # Resolusi upstream saat request (bukan saat start) agar nginx tetap hidup bila backend belum ada.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  location /api/ {
    include /etc/nginx/snippets/security-headers.conf;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /ws {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 75s;
  }

  # Q11 (docs/19 §3): kelak rute publik event diteruskan ke Go yang menyuntik meta + JSON-LD:
  # location ~ ^/events/[^/]+$ { set $api_upstream ${API_UPSTREAM}; proxy_pass $api_upstream; }
  # JANGAN diaktifkan sebelum handler-nya ada (akan 404 dan memutus halaman event).

  # Aset ber-hash: cache panjang. Dibuat sebelum fallback agar tidak tertimpa.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # index.html jangan di-cache agar rilis baru langsung terlihat.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
